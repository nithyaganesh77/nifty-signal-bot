# Copy this file to .env and fill in your own values.
# See README.md for how to get a Telegram bot token and chat id.

TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenFromBotFather
TELEGRAM_CHAT_ID=123456789

# Yahoo Finance ticker + a friendly label used in messages.
# ^NSEI = Nifty 50 index. Change to e.g. ^NSEBANK for Bank Nifty,
# or a stock ticker like RELIANCE.NS.
SYMBOL=^NSEI
SYMBOL_LABEL=NIFTY 50

# How often (seconds) the bot polls Yahoo Finance for new data.
POLL_SECONDS=30
RSI_LENGTH=14

# NSE regular session
MARKET_OPEN=09:15
MARKET_CLOSE=15:30

LOG_FILE=signal_bot.log
# Send a short "bot is alive" message once a day at market open
SEND_HEARTBEAT=true

# --- Strategy 1: Heiken Ashi + Parabolic SAR + RSI (3-minute chart) --------
STRATEGY1_ENABLED=true
BAR_MINUTES=3
SAR_START=0.02
SAR_STEP=0.02
SAR_MAX=0.2
STATE_FILE=state.json

# --- Strategy 2: RSI Divergence + Bollinger Bands (1-minute chart) ---------
STRATEGY2_ENABLED=true
BAR_MINUTES_2=1
BB_LENGTH=20
BB_MULT=2.0
# swing-point confirmation window (bars each side); higher = fewer, more
# reliable pivots but slower to confirm
PIVOT_LEFT=3
PIVOT_RIGHT=3
STATE_FILE_2=state_rsi_bb.json

# --- Strategy 3: RSI + VWAP Scalping (1-minute chart) -----------------------
STRATEGY3_ENABLED=true
BAR_MINUTES_3=1
# how many bars back an RSI oversold/overbought reading still "counts"
# when the VWAP touch happens a few bars later
VWAP_RECENT_WINDOW=10
# which VWAP std-dev band (1, 2 or 3) is used as the target
VWAP_TARGET_BAND=1
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70
STATE_FILE_3=state_rsi_vwap.json

# --- Strategy 4: 1-Minute Consolidation Breakout Scalping ------------------
STRATEGY4_ENABLED=true
BAR_MINUTES_4=1
EMA_LENGTH=9
TREND_LOOKBACK=15
RANGE_BARS=5
ATR_LENGTH=14
# how tight the pre-breakout range must be, as a multiple of ATR
CONSOLIDATION_MAX_ATR_MULT=1.5
TARGET_RR=3.0
# force-close a trade after this many minutes if neither target nor SL hit
TIME_EXIT_BARS=10
STATE_FILE_4=state_consolidation.json

# --- Strategy 5: Moving Average Scalping (5-min, first hour only) ----------
STRATEGY5_ENABLED=true
BAR_MINUTES_5=5
# 5 or 7 both work per the strategy
EMA_LENGTH_5=7
# only take setups/entries between MARKET_OPEN and this time
FIRST_HOUR_END=10:15
# minimum 1:3, can go up to 1:4
TARGET_RR_5=3.0
STATE_FILE_5=state_ma_scalp.json

# --- Strategy 6: Mean Reversion EMA(5,14) + Martingale sizing (1-min) ------
STRATEGY6_ENABLED=true
BAR_MINUTES_6=1
EMA_FAST_6=5
EMA_SLOW_6=14
# 1:1 per the write-up
TARGET_RR_6=1.0
# Martingale position-size suggestion doubles after each stop-loss, capped
# here, and resets to 1x after a target hit. Sizing suggestion only — the
# bot doesn't place orders or track real capital.
MARTINGALE_MAX_MULTIPLIER=8
STATE_FILE_6=state_meanrev_martingale.json

# --- Strategy 7: Moving Average + Fibonacci (5-min) -------------------------
STRATEGY7_ENABLED=true
BAR_MINUTES_7=5
SMA_LENGTH_7=200
PIVOT_LEFT_7=3
PIVOT_RIGHT_7=3
MA_SLOPE_LOOKBACK_7=5
# minimum 1:2 per the write-up
TARGET_RR_7=2.0
STATE_FILE_7=state_ma_fib.json

# --- Strategy 8: Supertrend + Pivot Points (5-min) --------------------------
STRATEGY8_ENABLED=true
BAR_MINUTES_8=5
# "Set the ATR range to 7"
ATR_LENGTH_8=7
SUPERTREND_MULT_8=3.0
STATE_FILE_8=state_supertrend_pivot.json

# --- Strategy 9: VWAP + Standard Deviations (5-min) -------------------------
STRATEGY9_ENABLED=true
BAR_MINUTES_9=5
VWAP_BAND_MULT_9=2.0
STATE_FILE_9=state_vwap_std.json

# --- Strategy 10: RSI + Volume Oscillator (5-min) ---------------------------
STRATEGY10_ENABLED=true
BAR_MINUTES_10=5
VOL_OSC_FAST_10=5
VOL_OSC_SLOW_10=10
PIVOT_LEFT_10=3
PIVOT_RIGHT_10=3
# conservative 1:2 per the write-up
TARGET_RR_10=2.0
STATE_FILE_10=state_rsi_volosc.json

# --- Strategy 11: Pullback + Pivot Points (5-min) ---------------------------
STRATEGY11_ENABLED=true
BAR_MINUTES_11=5
# fallback only — target is normally the next pivot level
TARGET_RR_11=2.0
STATE_FILE_11=state_pivot_pullback.json

# --- Strategy 12: Double RSI (5-min + hourly) -------------------------------
STRATEGY12_ENABLED=true
BAR_MINUTES_12=5
STATE_FILE_12=state_double_rsi.json

# --- Strategy 13: CPR with Trend Following (5-min) --------------------------
STRATEGY13_ENABLED=true
BAR_MINUTES_13=5
ATR_LENGTH_13=14
# CPR width <= this * ATR counts as "narrow" (breakout mode); wider counts
# as "wide" (range-fade mode)
CPR_NARROW_ATR_MULT_13=1.0
# 1:2 per the write-up
TARGET_RR_13=2.0
STATE_FILE_13=state_cpr_trend.json

# --- Reward / penalty scoring (shown in Telegram messages) -----------------
REWARD_TARGET1=0.5
REWARD_TARGET2=1.0
REWARD_TARGET=1.0
PENALTY_STOPLOSS=1.0
